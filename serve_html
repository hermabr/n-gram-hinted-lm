#!/usr/bin/env -S uv run --script

import argparse
import errno
import gzip
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
from http import HTTPStatus
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from io import BytesIO
from pathlib import Path
from urllib.parse import parse_qs, urlsplit


STARTUP_TIMEOUT_SECONDS = 10
TUNNEL_STARTUP_TIMEOUT_SECONDS = 30
QUICK_TUNNEL_URL_PATTERN = re.compile(rb"https://[a-z0-9-]+\.trycloudflare\.com")


class TunnelStartupError(RuntimeError):
    pass


class SVGZRequestHandler(SimpleHTTPRequestHandler):
    extensions_map = {**SimpleHTTPRequestHandler.extensions_map, ".svgz": "image/svg+xml"}
    _gzip_cache: dict[Path, tuple[int, int, bytes]] = {}
    _gzip_cache_lock = threading.Lock()
    page: str | None = None  # the file, from the repo root, served at / (else the directory's index.html)

    def accepts_gzip(self) -> bool:
        accepted: dict[str, float] = {}
        for item in self.headers.get("Accept-Encoding", "").lower().split(","):
            name, *parameters = item.strip().split(";")
            if not name:
                continue
            quality = 1.0
            for parameter in parameters:
                key, separator, value = parameter.strip().partition("=")
                if key == "q" and separator:
                    try:
                        quality = float(value)
                    except ValueError:
                        quality = 0.0
            accepted[name] = quality
        return accepted.get("gzip", accepted.get("*", 0.0)) > 0

    @classmethod
    def gzip_file(cls, path: Path) -> tuple[bytes, os.stat_result]:
        path = path.resolve()
        stat = path.stat()
        with cls._gzip_cache_lock:
            cached = cls._gzip_cache.get(path)
            if cached is None or cached[:2] != (stat.st_mtime_ns, stat.st_size):
                cached = (stat.st_mtime_ns, stat.st_size, gzip.compress(path.read_bytes(), compresslevel=9, mtime=0))
                cls._gzip_cache[path] = cached
        return cached[2], stat

    def git_status(self):
        """GET /__git__?dir=<a directory, from the repo root>: the repository's GitHub URL, branch and latest commit
        now, and whether every file in the directory is in that commit unchanged (no untracked or modified files)."""
        directory = parse_qs(urlsplit(self.path).query).get("dir", [""])[0].strip("/")

        def git(*args: str) -> str:
            return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout.strip()

        try:
            remote = git("remote", "get-url", "origin")
            branch, commit = git("rev-parse", "--abbrev-ref", "HEAD"), git("rev-parse", "HEAD")
            committed = bool(directory) and bool(git("ls-files", "--", directory)) and not git("status", "--porcelain", "--", directory)
        except (OSError, subprocess.CalledProcessError) as error:
            body = {"error": str(error)}
        else:
            github = re.fullmatch(r"(?:git@github\.com:|https://github\.com/)(.+?)(?:\.git)?", remote)
            body = {
                "repository": f"https://github.com/{github[1]}" if github else None,
                "branch": commit if branch == "HEAD" else branch,
                "commit": commit,
                "committed": committed,
            }
        content = json.dumps(body).encode()
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(content)))
        self.end_headers()
        return BytesIO(content)

    def send_head(self):
        request_path = urlsplit(self.path).path
        if request_path == "/__git__":
            return self.git_status()
        if request_path == "/" and self.page is not None:
            self.path = "/" + self.page
        source = Path(self.translate_path(self.path))
        if request_path.startswith("/assets/") and source.suffix == ".js" and self.accepts_gzip() and source.is_file():
            content, stat = self.gzip_file(source)
            etag = f'"{stat.st_mtime_ns:x}-{stat.st_size:x}-gzip"'
            if self.headers.get("If-None-Match") == etag:
                self.send_response(HTTPStatus.NOT_MODIFIED)
                self.send_header("ETag", etag)
                self.send_header("Content-Encoding", "gzip")
                self.send_header("Vary", "Accept-Encoding")
                self.end_headers()
                return None
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", self.guess_type(str(source)))
            self.send_header("Content-Encoding", "gzip")
            self.send_header("Vary", "Accept-Encoding")
            self.send_header("Content-Length", str(len(content)))
            self.send_header("Last-Modified", self.date_time_string(stat.st_mtime))
            self.send_header("ETag", etag)
            self.end_headers()
            return BytesIO(content)
        return super().send_head()

    def guess_type(self, path: str) -> str:
        if path.endswith(".json.gz"):
            return "application/json"
        return super().guess_type(path)

    def send_header(self, keyword: str, value: str) -> None:
        mime_type = value.partition(";")[0].strip().lower()
        if keyword.lower() == "content-type" and mime_type == "text/html" and "charset=" not in value.lower():
            value = f"{value}; charset=utf-8"

        super().send_header(keyword, value)
        request_path = urlsplit(self.path).path
        if keyword.lower() == "content-type" and (
            mime_type == "image/svg+xml" or (mime_type == "application/json" and request_path.endswith(".json.gz"))
        ):
            super().send_header("Content-Encoding", "gzip")


def port_number(value: str) -> int:
    try:
        port = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("port must be an integer") from error

    if not 1 <= port <= 65535:
        raise argparse.ArgumentTypeError("port must be between 1 and 65535")
    return port


def report_startup(ready_fd: int, status: str) -> None:
    os.write(ready_fd, status.encode())
    os.close(ready_fd)


def run_server(port: int, ready_fd: int | None = None, page: str | None = None) -> int:
    SVGZRequestHandler.page = page
    try:
        server = ThreadingHTTPServer(("", port), SVGZRequestHandler)
    except OSError as error:
        if ready_fd is not None:
            if error.errno == errno.EADDRINUSE:
                report_startup(ready_fd, "port-in-use")
            else:
                report_startup(ready_fd, f"error:{error}")
        elif error.errno == errno.EADDRINUSE:
            print(f"serve_html: error: port {port} is already in use", file=sys.stderr)
        else:
            print(f"serve_html: error: {error}", file=sys.stderr)
        return 1

    if ready_fd is not None:
        report_startup(ready_fd, "ready")
    else:
        print(f"Serving HTTP on port {port} (http://localhost:{port}/)", flush=True)

    try:
        with server:
            server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def stop_process(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    process.terminate()
    try:
        process.wait(timeout=2)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def free_port(port: int) -> bool:
    """Stop the processes listening on `port` (found with lsof): SIGTERM, then SIGKILL after 2 seconds."""
    lsof = shutil.which("lsof")
    if lsof is None:
        print("serve_html: error: -f requires lsof to find what holds the port (or use --soft-f)", file=sys.stderr)
        return False
    found = subprocess.run([lsof, "-t", f"-iTCP:{port}", "-sTCP:LISTEN"], capture_output=True, text=True, check=False)
    pids = {int(pid) for pid in found.stdout.split()} - {os.getpid()}
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        except PermissionError:
            print(f"serve_html: error: port {port} is held by PID {pid}, which this user cannot stop", file=sys.stderr)
            return False
        print(f"Stopped PID {pid}, which was listening on port {port}")

    def alive(pid: int) -> bool:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        return True

    deadline = time.monotonic() + 2
    while any(alive(pid) for pid in pids) and time.monotonic() < deadline:
        time.sleep(0.05)
    for pid in pids:
        if alive(pid):
            os.kill(pid, signal.SIGKILL)
    return True


def start_server(port: int, *, detached: bool, page: str | None = None) -> subprocess.Popen[bytes] | None:
    read_fd, write_fd = os.pipe()
    command = [
        sys.executable,
        str(Path(__file__).resolve()),
        "--_serve",
        "--port",
        str(port),
        "--ready-fd",
        str(write_fd),
        *(["--page", page] if page is not None else []),
    ]

    try:
        process = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL if detached else None,
            stderr=subprocess.DEVNULL if detached else None,
            start_new_session=detached,
            pass_fds=(write_fd,),
        )
    except OSError as error:
        os.close(read_fd)
        os.close(write_fd)
        print(f"serve_html: error: could not start server: {error}", file=sys.stderr)
        return None

    os.close(write_fd)
    try:
        readable, _, _ = select.select([read_fd], [], [], STARTUP_TIMEOUT_SECONDS)
        status = os.read(read_fd, 4096).decode() if readable else "timeout"
    finally:
        os.close(read_fd)

    if status == "ready" and process.poll() is None:
        return process

    if process.poll() is None:
        stop_process(process)
    else:
        process.wait()

    if status == "port-in-use":
        print(f"serve_html: error: port {port} is already in use", file=sys.stderr)
    elif status.startswith("error:"):
        print(f"serve_html: {status.removeprefix('error:')}", file=sys.stderr)
    elif status == "timeout":
        print("serve_html: error: timed out while starting server", file=sys.stderr)
    else:
        print("serve_html: error: server exited during startup", file=sys.stderr)
    return None


def launch_server(port: int, page: str | None = None) -> int:
    process = start_server(port, detached=True, page=page)
    if process is None:
        return 1
    print(f"Serving HTTP on port {port} (http://localhost:{port}/)")
    print(f"Server PID: {process.pid}")
    return 0


def start_quick_tunnel(port: int, cloudflared: str, *, detached: bool) -> tuple[subprocess.Popen[bytes], str]:
    command = [cloudflared, "tunnel", "--url", f"http://localhost:{port}"]

    with tempfile.TemporaryFile() as log:
        try:
            process = subprocess.Popen(
                command,
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=detached,
            )
        except OSError as error:
            raise TunnelStartupError(f"could not start cloudflared: {error}") from error

        deadline = time.monotonic() + TUNNEL_STARTUP_TIMEOUT_SECONDS
        output = b""
        try:
            while time.monotonic() < deadline:
                log.seek(len(output))
                output += log.read()
                match = QUICK_TUNNEL_URL_PATTERN.search(output)
                if match is not None:
                    return process, match.group().decode()
                if process.poll() is not None:
                    raise TunnelStartupError("cloudflared exited before publishing a tunnel URL")
                time.sleep(0.1)
            raise TunnelStartupError("timed out waiting for a Cloudflare Quick Tunnel URL")
        except BaseException:
            stop_process(process)
            raise


def supervise(server: subprocess.Popen[bytes], tunnel: subprocess.Popen[bytes]) -> int:
    try:
        while server.poll() is None and tunnel.poll() is None:
            time.sleep(0.2)
    except KeyboardInterrupt:
        return_code = 0
    else:
        if server.poll() is not None:
            print("serve_html: error: HTML server exited", file=sys.stderr)
        else:
            print("serve_html: error: cloudflared exited", file=sys.stderr)
        return_code = 1
    finally:
        stop_process(tunnel)
        stop_process(server)
    return return_code


def launch_quick_tunnel(port: int, *, foreground: bool, page: str | None = None) -> int:
    cloudflared = shutil.which("cloudflared")
    if cloudflared is None:
        print(
            "serve_html: error: --cloudflare requires cloudflared to be installed and available on PATH",
            file=sys.stderr,
        )
        return 1

    server = start_server(port, detached=not foreground, page=page)
    if server is None:
        return 1

    try:
        tunnel, url = start_quick_tunnel(port, cloudflared, detached=not foreground)
    except KeyboardInterrupt:
        stop_process(server)
        return 0
    except TunnelStartupError as error:
        stop_process(server)
        print(f"serve_html: error: {error}", file=sys.stderr)
        return 1

    print(f"Serving HTTP on port {port} (http://localhost:{port}/)")
    print(f"Cloudflare Quick Tunnel: {url}")
    print(f"Server PID: {server.pid}")
    print(f"Tunnel PID: {tunnel.pid}")
    if not foreground:
        return 0
    return supervise(server, tunnel)


def main() -> int:
    assert Path("pyproject.toml").is_file() and Path("assets").is_dir(), (
        "serve_html must be launched from the repository root containing pyproject.toml and assets/"
    )
    if "--_serve" in sys.argv:
        parser = argparse.ArgumentParser(add_help=False)
        parser.add_argument("--_serve", action="store_true")
        parser.add_argument("--port", type=port_number, required=True)
        parser.add_argument("--ready-fd", type=int, required=True)
        parser.add_argument("--page")
        args = parser.parse_args()
        return run_server(args.port, args.ready_fd, args.page)

    parser = argparse.ArgumentParser(description="Start an HTML server.")
    parser.add_argument("-p", "--port", type=port_number, default=8000)
    parser.add_argument(
        "-f",
        "--foreground",
        action="store_true",
        help="run in the foreground instead of detaching, first stopping whatever listens on the port",
    )
    parser.add_argument(
        "--soft-f",
        action="store_true",
        help="run in the foreground, but fail if the port is in use rather than stopping what holds it",
    )
    parser.add_argument(
        "--cloudflare",
        "--quick-tunnel",
        dest="quick_tunnel",
        action="store_true",
        help="expose the server through a Cloudflare Quick Tunnel (requires cloudflared)",
    )
    parser.add_argument("--page", help="serve this file (from the repo root) at / instead of index.html")
    args = parser.parse_args()
    if args.page is not None and not Path(args.page).is_file():
        print(f"serve_html: error: {args.page} does not exist", file=sys.stderr)
        return 1
    if args.foreground and not free_port(args.port):
        return 1
    foreground = args.foreground or args.soft_f
    if args.quick_tunnel:
        return launch_quick_tunnel(args.port, foreground=foreground, page=args.page)
    if foreground:
        return run_server(args.port, page=args.page)
    return launch_server(args.port, args.page)


if __name__ == "__main__":
    raise SystemExit(main())
